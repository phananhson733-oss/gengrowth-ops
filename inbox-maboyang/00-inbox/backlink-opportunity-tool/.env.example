# 默认免费发现链路：本机或自托管 SearXNG。
SEARXNG_BASE_URL=http://127.0.0.1:8080

# 可选：仅当直接抓取失败且页面需要 JavaScript 渲染时才调用自托管 Firecrawl。
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=

# 仅供 docker-compose.searxng.yml 使用；请改成随机长字符串，勿提交 .env。
SEARXNG_SECRET=

# Google Sheet Apps Script Web App 部署完成后填写。
GOOGLE_SHEET_WEBAPP_URL=
GOOGLE_SHEET_SHARED_SECRET=
