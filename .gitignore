# Obsidian 配置（每人不同，不入库）
.obsidian/
.obsidian.workspace*

# Excalidraw 本地绘图目录（含其文件和子文件夹）
/inbox-pengman/Excalidraw/

# macOS
.DS_Store

# Node
node_modules/

# IDE
.vscode/
.idea/

# 临时文件
*.tmp
*.swp
*~
.gstack/

# autopilot / flow-driver 机器运行时状态文件（自动生成的"机器人流水账"，
# 频繁变动且无需人工阅读，停止同步以避免反复的合并冲突弹窗）
**/.autopilot-claims.json
**/.autopilot-claims.json.bak*
**/.flow-driver-*.json

# 凭证类文件：本仓库是 PUBLIC 仓库，任何提交进来的密钥都会立即对全网公开。
# wiki/tools 每 60s 自动 rsync 进 ops/tools，2026-06-23 一个 Chrome 扩展打包
# 私钥就这样被公开了 24 天(commit 5edc426)。
# 为什么必须在这里挡：_sync-core.sh 的 rsync --exclude 只在拉到新脚本的机器上
# 生效，多机环境下传播有延迟——2026-07-17 就是另一台机器用旧脚本把该 .pem
# 又提交了回来(5718bef)。.gitignore 随 git 走，所有机器立即生效，是可靠防线。
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
.env
.env.*

# tools/ 只收 wiki 白名单镜像（目前仅 internal/link-attribution，与 .github/sync-dirs.txt 一致），
# 其余是内部工具，不入库。旧版 _sync-core.sh 会把 wiki/tools 整个镜像进来，wiki 侧已改为
# 白名单；还在跑旧脚本的机器靠这里挡住——.gitignore 随 git 走，所有机器 pull 后立即生效。
# 要新增公开工具：先改 wiki 的 sync-to-ops.yml 与 _sync-core.sh 白名单，再在这里放行。
/tools/*
!/tools/internal/
/tools/internal/*
!/tools/internal/link-attribution/
