# 全局配置
global:
  # total_weekly_quota 自动计算：sum(accounts[status=active].weekly_quota)
  # 当前 = 2 + 2 + 1 + 3 = 8

  extra_inventory_target: 2  # 每周额外完成的发布级机动库存
  max_producing_parallel: 3  # 同时在制上限
  max_edited_inventory_weeks: 2  # 已剪辑成片库存上限（未来 N 周）

  pool_ratio_reference:  # 只是排期参考，不强制凑满
    hot: 0.15
    predictable: 0.25
    evergreen: 0.60

# 使用说明
# 1. 新增账号：添加新的 account 条目，设 status: active
# 2. 删除账号：设 status: inactive（保留历史记录）或直接删除条目
# 3. 调整配额：修改 weekly_quota，总配额自动重新计算
# 4. 修改后运行：./scripts/sync-quota-snapshot.sh 同步到 SOP
