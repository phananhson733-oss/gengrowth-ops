# AstrologyWiki 账号矩阵配置
# 位置: 04-production/00-config/accounts.yaml
# 新增/删除账号只需修改此文件

accounts:
  - id: astrologywiki-official
    handle: "@astrologywiki"
    platform: tiktok
    role: 品牌、天象、工具承接
    weekly_quota: 2
    content_fit:
      - Predictable transit
      - 可靠解释
      - 工具演示
    boundaries:
      - 非宿命
      - 事实准确
      - 轻 CTA
    min_inventory: 2
    status: active

  - id: ai-astrologer
    handle: "@ai.astrologer"
    platform: tiktok
    role: 占星 × 心理机制
    weekly_quota: 2
    content_fit:
      - 单一 sign/placement + 具体关系
      - 人格行为
    boundaries:
      - 固定人设和形式
      - 不做无依据排行
    min_inventory: 2
    status: active

  - id: hot-astro-test
    handle: "@hotastrotest"
    platform: tiktok
    role: 事件流量测试
    weekly_quota: 1
    is_hot_slot: true
    content_fit:
      - 明星、情侣、影视、体育
      - 突发讨论
    boundaries:
      - 解释而不预测
      - 24-48h 时效优先
    min_inventory: 2
    status: active

  - id: casual-astro-lover
    handle: "@casualastro"
    platform: tiktok
    role: 低成本 Hook 探测
    weekly_quota: 3
    content_fit:
      - Sun Sign
      - 关系梗
      - slideshow/photo
    boundaries:
      - 口语化
      - 快速
      - 不过度品牌化
    min_inventory: 3
    status: active

