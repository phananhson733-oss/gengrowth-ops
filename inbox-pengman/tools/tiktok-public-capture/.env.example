# Google Sheets is optional. Local SQLite/Excel/CSV always run first.
GOOGLE_SHEETS_ENABLED=true

# Create a blank Google Sheet, share it with the service account email as Editor,
# then paste the spreadsheet ID from its URL here.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Keep the JSON key outside the repository.
GOOGLE_SERVICE_ACCOUNT_JSON=~/.config/gengrowth/tiktok-sheets-service-account.json

# Daily target time in Beijing time (24-hour HH:MM). launchd checks every 15 minutes.
SCHEDULE_TIME_BJ=10:00

# Optional Feishu Bitable follower sync. Keep disabled until a read-only test and one-row canary pass.
FEISHU_SYNC_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_NODE_TOKEN=QCigwFYMCiuQu1k8q94cXy7PnZd
FEISHU_TABLE_ID=tbl1LkOftGc2aHis
