# Existing TikTok collector settings. Non-sensitive legacy flags may retain documented defaults;
# credentials, resource IDs, actor/chat IDs, and local credential paths must stay blank in Git.
# Local SQLite/Excel/CSV run first.
GOOGLE_SHEETS_ENABLED=true

# Existing optional Google export. Spreadsheet ID and credential path stay blank in Git.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Existing collector schedule setting. The v5 Runner has its own Beijing 08:00 schedule.
SCHEDULE_TIME_BJ=10:00

# Short-drama v5 Runner credentials and fixed Base resources.
# Copy real values through the approved secret channel; never commit them.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SHORTDRAMA_APP_TOKEN=
FEISHU_SHORTDRAMA_ACCOUNTS_TABLE_ID=
FEISHU_SHORTDRAMA_POOL_TABLE_ID=
FEISHU_SHORTDRAMA_CAPTURES_TABLE_ID=
FEISHU_SHORTDRAMA_RELEASES_TABLE_ID=

# Comma-separated Feishu IDs selected by shortdrama.runtime.json.
SHORTDRAMA_OPERATOR_IDS=
SHORTDRAMA_PRIVILEGED_IDS=
SHORTDRAMA_NOTIFICATION_CHAT_IDS=

# Fixed daily-health target; it must also appear in SHORTDRAMA_NOTIFICATION_CHAT_IDS.
SHORTDRAMA_OPS_CHAT_ID=

# Optional historical follower sync (unchanged feature, not the v5 Runner).
# Leave disabled unless its separate read-only test and canary are authorized.
FEISHU_SYNC_ENABLED=false
FEISHU_WIKI_NODE_TOKEN=
FEISHU_TABLE_ID=
