<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gengrowth.shortdrama-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__RUNNER_DIR__/run_scheduled.sh</string>
    <string>__CONFIG_PATH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUNNER_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SHORTDRAMA_NODE_BIN</key>
    <string>__NODE_BIN__</string>
    <key>SHORTDRAMA_CAPABILITY_FILE</key>
    <string>__CAPABILITY_FILE__</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__RUNNER_DIR__/logs/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNNER_DIR__/logs/launchd.stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
