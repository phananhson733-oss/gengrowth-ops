      {
        "id": "fldojvZ99z",
        "name": "剧ID",
        "style": {
          "rules": [
            {
              "text": "SD-",
              "type": "text"
            },
            {
              "length": 6,
              "type": "incremental_number"
            }
          ]
        },
        "type": "auto_number"
      },
      {
        "description": "按剧ID精确对应短剧播放数据汇总的是否出单；该源字段根据CPS账号数据明细 手动版中历史订单金额\u003e0且完整剧名匹配的记录自动计算，不限制订单日期。源表有已出单记录显示已出单，否则留空；空白表示当前暂无匹配出单记录，不断言从未出单。按剧ID联动，不以发布人或模糊标题判断。；已合并的旧播放汇总不参与当前出单剧计数。",
        "expression": "IF(AND(NOT(ISBLANK([剧ID])),[短剧播放数据汇总].COUNTIF(AND(CurrentValue.[剧ID]=[剧ID],CurrentValue.[是否出单]=\"已出单\",CurrentValue.[统计状态]!=\"已合并\"))\u003e0),\"已出单\",\"\")",
        "id": "fldjORFyLe",
        "name": "是否出过单",
        "type": "formula"
      },
