# At least one discovery key is required to run a discovery task.
SERPAPI_API_KEY=
AHREFS_API_KEY=

# Optional Google Sheet receiver deployment.
GOOGLE_SHEET_WEBAPP_URL=
GOOGLE_SHEET_SHARED_SECRET=

# The service is intentionally loopback-only. Change only if the launchd label
# is installed on a host where another process already uses this port.
PORT=4318
